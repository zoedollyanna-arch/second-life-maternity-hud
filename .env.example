# Supabase → Connect → Transaction pooler URI (port 6543).
# Username must be postgres.<project-ref>, not just postgres.
DATABASE_URL=postgresql://postgres.yourref:password@aws-0-your-region.pooler.supabase.com:6543/postgres
SL_API_SECRET=2175039403870ed15116d0dcf330095af3f6a398e83bca01
APP_URL=https://second-life-maternity-hud-t2b3.onrender.com

# Optional. Postgres pool size for this process (default 10). Supabase pooler
# plans cap total clients, and that budget is shared with anything else on the
# project — lower this for a second worker or a test run so the web app keeps
# its connections. Integration tests are usually run with PGPOOL_MAX=3.
# PGPOOL_MAX=10

# Optional. Set to a SCRATCH database to run the integration test suite:
#   PGPOOL_MAX=3 TEST_DATABASE_URL=postgres://... npm test
# The suite creates its own throwaway avatars and deletes them afterwards, but
# never point it at a database with real players in it.
# TEST_DATABASE_URL=
